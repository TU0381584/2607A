\newlabel{fig:collapse}{{2}{9}{Fraction of the 30 campaign seeds reaching genuine, correctly-targeted differentiated shedding (mMTC-only blocking under congestion), across the original unnormalised encoder and the two fixes described in Section~\ref {sec:collapse}}{figure.2}{}}
\newlabel{sec:correctness-metrics}{{5}{9}{Evaluation-Integrity Findings: A Training Collapse, Diagnosed and Fixed}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces M2 centralised campaign, per-seed evidence for the correctness-aware metrics (Section~\ref {sec:correctness-metrics}). (a) Paired per-seed comparison against single-agent DQN on mean reward per step. Each line is one seed, coloured by whether GAT-CTDE scored higher (green, 20), tied (grey, 3), or lower (red, 7), the source of this figure's borderline $p=0.0577$. (b) Full per-seed reward distribution for all three arms; GAT-CTDE is split into seeds that learned genuine differentiated shedding (blue, 21) versus seeds still stuck at the always-accept collapse (grey $\times $, 9), shown without claiming the split predicts reward, since several still-collapsed seeds score among the arm's highest.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:m2-results}{{3}{10}{M2 centralised campaign, per-seed evidence for the correctness-aware metrics (Section~\ref {sec:correctness-metrics}). (a) Paired per-seed comparison against single-agent DQN on mean reward per step. Each line is one seed, coloured by whether GAT-CTDE scored higher (green, 20), tied (grey, 3), or lower (red, 7), the source of this figure's borderline $p=0.0577$. (b) Full per-seed reward distribution for all three arms; GAT-CTDE is split into seeds that learned genuine differentiated shedding (blue, 21) versus seeds still stuck at the always-accept collapse (grey $\times $, 9), shown without claiming the split predicts reward, since several still-collapsed seeds score among the arm's highest}{figure.3}{}}
