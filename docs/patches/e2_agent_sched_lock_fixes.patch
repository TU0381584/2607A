diff --git a/oai_ran/openair2/E2_AGENT/e2_message_handlers.c b/oai_ran/openair2/E2_AGENT/e2_message_handlers.c
index 0abf654..d6700c6 100644
--- a/oai_ran/openair2/E2_AGENT/e2_message_handlers.c
+++ b/oai_ran/openair2/E2_AGENT/e2_message_handlers.c
@@ -199,6 +199,14 @@ void apply_slicing_ctrl(SlicingControlM* slicing_ctrl_mess)
     min_ratio = slicing_ctrl_mess->min_ratio;
     max_ratio = slicing_ctrl_mess->max_ratio;
 
+    // SL_info is also read every scheduling slot by the DL/UL scheduler
+    // (gNB_scheduler_dlsch.c's nr_slice_preprocess/slice_prb_estimate,
+    // which run under sched_lock -- see NR_SCHED_ENSURE_LOCKED there).
+    // This E2-triggered write previously took no lock at all, unlike
+    // every other asynchronous external writer into gNB_MAC_INST state
+    // (see mac_rrc_dl_handler.c), making it a genuine unsynchronized
+    // data race against the real-time scheduler thread.
+    NR_SCHED_LOCK(&mac->sched_lock);
     SL_iterator(SL_info->list, SL) {
       if (SL->nssai.sst == sst && SL->nssai.sd == sd) {
         SL->spolicy.min_ratio = min_ratio;
@@ -207,6 +215,7 @@ void apply_slicing_ctrl(SlicingControlM* slicing_ctrl_mess)
       }
       sum_min_ratio += SL->spolicy.min_ratio;
     }
+    NR_SCHED_UNLOCK(&mac->sched_lock);
     if (sum_min_ratio > 100)
         AssertFatal(1 == 0, "Sum of min ratios in the prb policy exceeding 100 \n");
 }
@@ -317,7 +326,27 @@ UeListM* get_ue_list(){
     UeListM* ue_list_m = malloc(sizeof(UeListM));
     ue_list_m__init(ue_list_m);
 
-    NR_UEs_t *UE_info_gnb = &RC.nrmac[0]->UE_info;
+    gNB_MAC_INST *mac = RC.nrmac[0];
+    NR_UEs_t *UE_info_gnb = &mac->UE_info;
+
+    // This function runs on the E2_AGENT's own real-time-priority thread on
+    // every single ran_read() (i.e. every INDICATION_REQUEST poll), and reads
+    // curr_ue->{is_GBR,avg_tbs_1s_dl/ul,avg_prbs_dl,avg_tbs_per_prb_dl},
+    // sched_ctrl (num_total_bytes, mcs, ph, pcmax, bler_stats, dl_sl_info),
+    // and mac_stats -- every one of which is mutated every slot by the
+    // real-time scheduler under sched_lock (nr_schedule_ue_spec asserts
+    // sched_lock held via NR_SCHED_ENSURE_LOCKED). It also walks
+    // UE_info_gnb->list itself, which mac_remove_nr_ue() only ever mutates
+    // under sched_lock + UE_info.mutex together (see dump_mac_stats() in
+    // main.c for the same double-lock convention on a read). This function
+    // previously took no lock at all -- a genuine, continuously-firing
+    // unsynchronized read of live scheduler state, unlike apply_slicing_ctrl
+    // (see e2_message_handlers.c's own fix above). Lock both, in the same
+    // order used everywhere else in this codebase, for the whole critical
+    // section -- not just the count loop -- so the list can't be mutated
+    // between counting UEs and reading their fields.
+    NR_SCHED_LOCK(&mac->sched_lock);
+    NR_SCHED_LOCK(&UE_info_gnb->mutex);
 
     // count how many ues are connected
     int num_ues;
@@ -331,6 +360,8 @@ UeListM* get_ue_list(){
     ue_list_m->connected_ues = num_ues;
     ue_list_m->n_ue_info = num_ues;
     if(num_ues == 0){
+        NR_SCHED_UNLOCK(&UE_info_gnb->mutex);
+        NR_SCHED_UNLOCK(&mac->sched_lock);
         return ue_list_m;
     }
     NR_UE_info_t* curr_ue;
@@ -405,6 +436,9 @@ UeListM* get_ue_list(){
     ue_info_list[num_ues] = NULL;
     // assign ue info pointer
     ue_list_m->ue_info = ue_info_list;
+
+    NR_SCHED_UNLOCK(&UE_info_gnb->mutex);
+    NR_SCHED_UNLOCK(&mac->sched_lock);
     return ue_list_m;
 }
 
