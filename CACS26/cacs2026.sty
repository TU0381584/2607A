%% cacs2026.sty
%% LaTeX formatting style converted from the official CACS 2026
%% Microsoft Word 6-page paper template.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cacs2026}[2026/07/24 CACS 2026 paper format]

% -----------------------------------------------------------------------------
% Page layout from the supplied Word template
%   Paper: US Letter (8.5 x 11 in)
%   Margins: 0.75 in on all sides
%   Header distance: 0.30 in from the top edge
%   Columns: two columns separated by 0.20 in
% -----------------------------------------------------------------------------
\RequirePackage[letterpaper,
  left=0.75in,
  right=0.75in,
  top=0.30in,
  bottom=0.75in,
  headheight=25pt,
  headsep=9pt,
  includehead,
  columnsep=0.20in]{geometry}

% Times New Roman-compatible text and mathematics.
\RequirePackage[T1]{fontenc}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage{microtype}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{indentfirst}
\RequirePackage{enumitem}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{url}
\RequirePackage{cite}
\RequirePackage{stfloats}
\RequirePackage{flafter}
\RequirePackage[section]{placeins}

% -----------------------------------------------------------------------------
% Font sizes and line spacing measured from the Word styles.
% Normal/Body Text: 10 pt with 11.4 pt leading.
% -----------------------------------------------------------------------------
\makeatletter
\renewcommand\normalsize{%
  \@setfontsize\normalsize{10pt}{11.4pt}%
  \abovedisplayskip 12pt plus 2pt minus 5pt%
  \abovedisplayshortskip 0pt plus 3pt%
  \belowdisplayshortskip 7pt plus 3pt minus 4pt%
  \belowdisplayskip \abovedisplayskip}
\renewcommand\small{\@setfontsize\small{9pt}{10.5pt}}
\renewcommand\footnotesize{\@setfontsize\footnotesize{8pt}{9.2pt}}
\makeatother

% Word Body Text:
% 10 pt Times New Roman, justified, 11.4 pt leading,
% 0.20 in first-line indent, 6 pt space after each paragraph.
\setlength{\parindent}{14.4pt}
\setlength{\parskip}{6pt}
\setlength{\columnsep}{0.20in}
\setlength{\columnseprule}{0pt}
\raggedbottom
\frenchspacing
\emergencystretch=1em

% Conference header shown on every page: 10.5 pt.
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{%
  \fontsize{10.5}{11.5}\selectfont
  2026 International Automatic Control Conference (CACS 2026)\\[-0.6pt]
  Taichung, Taiwan, October 21--24, 2026}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% No printed page numbers.
\pagenumbering{gobble}

% -----------------------------------------------------------------------------
% Main section hierarchy, matching Word Heading 1/2 styles.
% -----------------------------------------------------------------------------
\renewcommand{\thesection}{\Roman{section}}
\renewcommand{\thesubsection}{\Alph{subsection}}
\renewcommand{\thesubsubsection}{\arabic{subsubsection}}

% Heading 1: 10 pt, centered, small caps; 12 pt before and 4 pt after.
\titleformat{\section}
  {\normalfont\fontsize{10}{11.4}\selectfont\centering\scshape}
  {\thesection.}{0.55em}{}
\titlespacing{\section}{0pt}{12pt}{4pt}

% Heading 2: 10 pt italic; 6 pt before and 3 pt after.
\titleformat{\subsection}
  {\normalfont\fontsize{10}{11.4}\selectfont\itshape}
  {\thesubsection.}{0.55em}{}
\titlespacing{\subsection}{0pt}{6pt}{3pt}

% Heading 3: 10 pt italic, run-in.
\titleformat{\subsubsection}[runin]
  {\normalfont\fontsize{10}{11.4}\selectfont\itshape}
  {\thesubsubsection.}{0.55em}{}
\titlespacing{\subsubsection}{14.4pt}{0pt}{0.45em}

% Unnumbered component headings (Appendix, Acknowledgment, References)
% inherit the 10 pt Heading 1 style in the Word template.
\newcommand{\componentheading}[1]{%
  \par\vspace{6pt}% together with paragraph spacing = 12 pt before
  \noindent\makebox[\columnwidth][c]{%
    \fontsize{10}{11.4}\selectfont\scshape #1}%
  \par\vspace{-2pt}}% net 4 pt after with the normal paragraph spacing

% -----------------------------------------------------------------------------
% Full-width title and author block.
% The explicit full-width makeboxes prevent either line from drifting into a
% single column and guarantee optical centering across the complete text area.
% Title: 16 pt bold. Authors: 11 pt. Title first, authors second.
% -----------------------------------------------------------------------------
\newcommand{\CACSmaketitle}[2]{%
  \twocolumn[{%
    \begin{@twocolumnfalse}
      \begingroup
      \setlength{\parskip}{0pt}%
      \setlength{\parindent}{0pt}%
      \noindent\makebox[\textwidth][c]{%
        \parbox{6.50in}{%
          \centering
          \fontsize{16}{19}\selectfont\bfseries #1\par
        }}%
      \par\vspace{12pt}% visible blank line between title and authors
      \noindent\makebox[\textwidth][c]{%
        \parbox{5.95in}{%
          \centering
          \fontsize{11}{12.5}\selectfont #2\par
        }}%
      \par\vspace{16pt}% Word Authors style: 16 pt after
      \endgroup
    \end{@twocolumnfalse}%
  }]%
}

% Abstract: 9 pt, bold, justified, 10.1 pt first-line indent.
\newenvironment{CACSabstract}
  {\begingroup
   \setlength{\parskip}{0pt}%
   \setlength{\parindent}{10.1pt}%
   \fontsize{9}{10.5}\selectfont\bfseries\ignorespaces}
  {\par\endgroup}
\newcommand{\abstractnameCACS}{\textit{Abstract}---}

% Unnumbered first-page sponsor/affiliation note: 8 pt.
\newcommand{\CACSfirstpagefootnote}[1]{%
  \begingroup
  \renewcommand{\thefootnote}{}%
  \footnotetext{%
    \fontsize{8}{9.2}\selectfont
    \setlength{\parindent}{10.1pt}%
    \setlength{\parskip}{0pt}%
    #1}%
  \addtocounter{footnote}{-1}%
  \endgroup
}

% Bullet list measured from Word numbering.xml:
% text starts 0.45 in from the column edge; bullet at about 0.20 in.
% Each bullet inherits the Body Text 6 pt paragraph-after spacing.
\setlist[itemize]{
  label=\textbullet,
  leftmargin=0.45in,
  labelindent=0.20in,
  labelsep=0.15in,
  itemsep=6pt,
  topsep=0pt,
  parsep=0pt,
  partopsep=0pt}
\setlist[enumerate]{
  leftmargin=0.45in,
  labelindent=0.20in,
  labelsep=0.15in,
  itemsep=6pt,
  topsep=0pt,
  parsep=0pt,
  partopsep=0pt}

% Captions: 8 pt. Word figure caption = 4 pt before / 10 pt after;
% Word table head = 12 pt before / 6 pt after.
\DeclareCaptionFont{cacsfont}{\fontsize{8}{9.2}\selectfont}
\captionsetup{font=cacsfont,labelfont=normalfont,labelsep=period,
  justification=centering,singlelinecheck=false}
\captionsetup[table]{position=top,aboveskip=12pt,belowskip=6pt,name=TABLE}
\captionsetup[figure]{position=bottom,aboveskip=4pt,belowskip=10pt,name=Figure}

% Table text: 8 pt.
\newcommand{\tabletext}{\fontsize{8}{9.2}\selectfont}

% Equation style: Word uses 12 pt before and after, 0.9 line spacing.
\setlength{\abovedisplayskip}{12pt}
\setlength{\belowdisplayskip}{12pt}
\setlength{\abovedisplayshortskip}{12pt}
\setlength{\belowdisplayshortskip}{12pt}

% Bibliography: 8 pt, justified, no extra space between entries.
\renewcommand{\refname}{REFERENCES}
\makeatletter
\renewenvironment{thebibliography}[1]
  {\componentheading{\refname}%
   \fontsize{8}{9.2}\selectfont
   \setlength{\parskip}{0pt}%
   \list{[\arabic{enumiv}]}%
     {\settowidth\labelwidth{[#1]}%
      \leftmargin\labelwidth
      \advance\leftmargin\labelsep
      \setlength{\labelsep}{0.35em}%
      \setlength{\itemsep}{0pt}%
      \setlength{\parsep}{0pt}%
      \setlength{\topsep}{0pt}%
      \usecounter{enumiv}}%
   \sloppy\clubpenalty4000\widowpenalty4000
   \sfcode`\.=1000\relax}
  {\endlist}
\makeatother

\AtBeginDocument{\normalsize}

\endinput
